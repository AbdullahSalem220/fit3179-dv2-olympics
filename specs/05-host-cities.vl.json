{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map: every Summer Games host city, circle area proportional to the medals Australia won there (all Games in that city added together). A world map with an enlarged inset of Europe, where host cities are close together.",
  "title": {
    "text": "Australia's medals by host city",
    "subtitle": "Circle area shows the medals Australia won in each Summer Games host city, 1896–2024. Cities that hosted more than once add their Games together.",
    "subtitleColor": "#5A6169",
    "subtitleFontSize": 14,
    "offset": 12
  },
  "data": {
    "url": "data/host_cities.csv"
  },
  "transform": [
    {
      "filter": "isValid(datum.total)"
    },
    {
      "calculate": "toString(datum.year)",
      "as": "games"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "total",
          "as": "medals"
        },
        {
          "op": "sum",
          "field": "gold",
          "as": "golds"
        },
        {
          "op": "count",
          "as": "games_count"
        },
        {
          "op": "min",
          "field": "games",
          "as": "first_games"
        },
        {
          "op": "max",
          "field": "games",
          "as": "last_games"
        }
      ],
      "groupby": [
        "city",
        "country",
        "lat",
        "lon"
      ]
    },
    {
      "filter": "datum.medals > 0"
    },
    {
      "calculate": "datum.city === 'Melbourne' || datum.city === 'Sydney' ? 'Home Games' : 'Overseas Games'",
      "as": "where"
    },
    {
      "calculate": "datum.games_count === 1 ? datum.first_games : datum.games_count + ' Games, ' + datum.first_games + ' to ' + datum.last_games",
      "as": "games_label"
    },
    {
      "calculate": "datum.city + ' ' + datum.medals",
      "as": "label"
    },
    {
      "calculate": "datum.lon > -15 && datum.lon < 40 && datum.lat > 34 && datum.lat < 62",
      "as": "in_europe"
    }
  ],
  "resolve": {
    "scale": {
      "size": "shared",
      "color": "shared"
    }
  },
  "spacing": 20,
  "hconcat": [
    {
      "width": 700,
      "height": 420,
      "projection": {
        "type": "equalEarth",
        "rotate": [
          -10,
          0
        ]
      },
      "layer": [
        {
          "data": {
            "url": "data/geo/world-110m.json",
            "format": {
              "type": "topojson",
              "feature": "countries"
            }
          },
          "transform": [
            {
              "filter": "datum.properties.name !== 'Antarctica'"
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#E9E5DC",
            "stroke": "#FAF8F3",
            "strokeWidth": 0.5
          }
        },
        {
          "data": {
            "values": [
              {
                "type": "Feature",
                "properties": {},
